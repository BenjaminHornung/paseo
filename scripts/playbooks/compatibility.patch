+  const nextModel = nextTarget ? ` on ${nextTarget}` : "";
+  return [
+    `A previous agent of this attempt (agent ${previousAgentId}${previousModel}) handed this attempt over to you${nextModel}.`,
+    `Before repeating or writing work, inspect the current workspace status and diff (git status, git diff HEAD), then read that agent's activity with get_agent_activity for agent ${previousAgentId}.`,
+  ].join(" ");
+}
