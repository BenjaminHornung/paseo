+/** PowerShell scripts are not directly executable on Windows; all other scripts keep their existing launch path. */
+function commandForScript(file: string): { command: string; args: string[] } {
+  if (process.platform === "win32" && path.extname(file).toLowerCase() === ".ps1") {
+    return { command: "pwsh.exe", args: ["-NoLogo", "-NoProfile", "-NonInteractive", "-File", file] };
+  }
+  return { command: file, args: [] };
+}
